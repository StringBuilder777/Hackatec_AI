# Copia este archivo a .env y rellena tus valores reales.
# .env nunca debe entrar al repositorio (está en .gitignore).

# OBLIGATORIO — obtén tu key en https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza_tu_key_aqui

# Opcional — puerto del backend (default 8080)
PORT=8080

# Opcional — debug | info | warning | error
LOG_LEVEL=info
